#!/bin/sh
# Refuse to push secrets or personal data. Installed by tools/install-hooks.sh.
#
# Every commit that is about to become public is scanned: the commits between
# what the remote has and what is being pushed, or, for a new branch, every
# commit not already on origin. The tree at the pushed tip is scanned too, so a
# file that is secret by name cannot slip through.
set -eu

root=$(git rev-parse --show-toplevel)
[ -f "$root/tools/check-sensitive.sh" ] || exit 0
cd "$root"

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a ref, nothing to publish

    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=origin"
    else
        range="$remote_sha..$local_sha"
    fi

    echo "check-sensitive: scanning $local_ref before push" >&2
    sh tools/check-sensitive.sh --range "$range" || status=1
done

exit "$status"
